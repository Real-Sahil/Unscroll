{
  "manifest_version": 2,
  "name": "UnScroll - Block Reels & Shorts",
  "version": "1.0.0",
  "description": "Block Instagram Reels, YouTube Shorts, TikTok, and other short-form video content to help you stay focused.",
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "webRequestBlocking",
    "*://instagram.com/*",
    "*://www.instagram.com/*",
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://youtu.be/*",
    "*://tiktok.com/*",
    "*://www.tiktok.com/*",
    "*://facebook.com/*",
    "*://www.facebook.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://instagram.com/*",
        "*://www.instagram.com/*",
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://youtu.be/*",
        "*://tiktok.com/*",
        "*://www.tiktok.com/*",
        "*://facebook.com/*",
        "*://www.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "UnScroll - Focus Mode",
    "default_icon": "images/icon-32.png"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
