{
  "manifest_version": 3,
  "name": "FocusFeed - Doomscroll Blocker",
  "version": "0.1.0",
  "description": "Block Instagram Reels, YouTube Shorts, and TikTok. Designed for addiction recovery.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.instagram.com/",
    "https://m.instagram.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.tiktok.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FocusFeed Status"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://m.instagram.com/*"
      ],
      "js": ["content/instagram-blocker.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content/youtube-blocker.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": ["content/tiktok-blocker.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
